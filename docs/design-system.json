    "headerHtml": "<header class=\"site-header\" role=\"banner\">\n  <div class=\"page-shell header-layout\">\n    <p class=\"site-mark\">Differential Equations Tutorials</p>\n    <nav aria-label=\"Primary navigation\" class=\"top-nav\">\n      <a href=\"#chapters\">Chapters</a>\n      <a href=\"#objectives\">Objectives</a>\n      <a href=\"#example\">Example</a>\n    </nav>\n  </div>\n</header>",
    "heroHtml": "<section class=\"hero\" aria-labelledby=\"hero-title\">\n  <p class=\"hero-kicker\">Foundational sequence · Interactive edition</p>\n  <h1 id=\"hero-title\">Differential Equations I</h1>\n  <p class=\"hero-subtitle\">A guided mathematical text for modeling motion, change, and structure through analytic reasoning and computational experiment.</p>\n  <p class=\"hero-cta\">Begin with <a href=\"level1/index.html\">Level I</a>, continue into <a href=\"level2/index.html\">Level II</a>.</p>\n</section>",
    "courseModuleListHtml": "<ol class=\"chapter-list\">\n  <li>\n    <a href=\"level1/index.html\" class=\"chapter-link\">\n      <div>\n        <h3><span>01</span> — Plotting Fundamentals</h3>\n        <p>Build geometric intuition with slope fields, trajectories, and numerical sketches.</p>\n      </div>\n      <p class=\"chapter-meta\">Beginner · 2–3 Hours</p>\n    </a>\n  </li>\n</ol>",
    "codeBlockHtml": "<figure class=\"code-example\">\n  <pre><code><span class=\"tok-keyword\">import</span> numpy <span class=\"tok-keyword\">as</span> np\n\n<span class=\"tok-keyword\">def</span> <span class=\"tok-function\">f</span>(x, y):\n    <span class=\"tok-keyword\">return</span> -2 * y</code></pre>\n  <figcaption>Output rule: y(x) = e^-2x decreases monotonically toward 0.</figcaption>\n</figure>"
